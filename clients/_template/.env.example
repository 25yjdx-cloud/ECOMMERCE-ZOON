# Per-client environment template. Copy to clients/SLUG/.env. Never commit .env.
# Variable names are confirmed in Phase 3 against the official starter's own .env.example.
STORE_CLIENT=SLUG
APP_MODE=store
DATA_SOURCE=bagisto
APP_URL=http://localhost:3000
BAGISTO_ENDPOINT=http://localhost:8080
BAGISTO_STOREFRONT_KEY=CHANGE_ME
NEXTAUTH_SECRET=CHANGE_ME
